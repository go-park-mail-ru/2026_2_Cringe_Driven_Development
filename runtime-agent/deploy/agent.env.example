HOST=127.0.0.1
PORT=8000
# The session, its language and token are not configured here: Go API assigns them once
# with POST /assign, and the agent keeps them in STATE_DIR. Never reuse STATE_DIR.
# Prepared by infra, including firewall; there is no default-network fallback.
KERNEL_NETWORK=cellestial-kernel
KERNEL_DNS=1.1.1.1
IDLE_TIMEOUT_SECONDS=900
MAX_OUTPUT_BYTES=10485760
PYTHON_IMAGE=cellestial-kernel-python:local
