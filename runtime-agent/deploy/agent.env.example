HOST=127.0.0.1
PORT=8000
# Сессия, её язык и токен здесь не настраиваются: Go API назначает их один раз
# через POST /assign, а агент хранит их в STATE_DIR. Никогда не переиспользуйте STATE_DIR.
# Готовится в infra, включая файрвол; фолбэка на сеть по умолчанию нет.
KERNEL_NETWORK=cellestial-kernel
KERNEL_DNS=1.1.1.1
IDLE_TIMEOUT_SECONDS=900
MAX_OUTPUT_BYTES=10485760
PYTHON_IMAGE=cellestial-kernel-python:local
