# Настройки HTTP сервера
HOST=0.0.0.0
PORT=8080
WRITE_TIMEOUT=15s
READ_TIMEOUT=15s
LOG_LEVEL=info

# Настройки PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secretpassword
POSTGRES_HOST=db
# Порт на хосте; внутри Compose PostgreSQL слушает 5432
POSTGRES_PORT=5432
POSTGRES_DB=app_db

# Redis: локальный сервис Compose; для API на хосте нужен доступный адрес.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis-local-development
REDIS_DB=0
REDIS_DIAL_TIMEOUT=2s
REDIS_OPERATION_TIMEOUT=1s

# Apidog: нужны только для make generate
APIDOG_TOKEN=
APIDOG_BRANCH_ID=

# Go API принимает запросы только от BFF. Оба секрета обязательны.
# Задайте отдельные случайные значения в локальном .env.
BFF_API_KEY=
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# S3 для аватаров. Локально SeaweedFS, на проде Selectel.
S3_PORT=8333
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=devkey
AWS_SECRET_ACCESS_KEY=devsecret
AWS_ENDPOINT_URL_S3=http://s3:8333

# Аватарки: отдельный бакет и URL, доступный браузеру. Обязательны для Go API.
# Compose создаёт бакет и разрешает анонимное чтение только его объектов.
S3_AVATARS_BUCKET=cellestial-avatars-local
S3_AVATARS_PUBLIC_URL=http://localhost:${S3_PORT}/${S3_AVATARS_BUCKET}
# В production значения и CDN задаёт infra (infra#30).

# Runtime пользовательских сессий (internal/runtime) всегда активен при корректной конфигурации.
# Для локальной разработки без облака: fake-провайдер (ключ — base64 от 32 байт,
# например `openssl rand -base64 32`). Для openstack нужны ещё RUNTIME_OS_*,
# RUNTIME_NETWORK_ID, RUNTIME_SUBNET_ID, RUNTIME_SECURITY_GROUP_ID, RUNTIME_IMAGE_ID,
# RUNTIME_FLAVOR_ID, RUNTIME_VOLUME_TYPE, RUNTIME_SSH_*, RUNTIME_TLS_*_FILE,
# RUNTIME_BLOCKED_PUBLIC_IPS и RUNTIME_ENV_NAME (без умолчания, для fake — dev-fake);
# их задаёт infra.
RUNTIME_PROVIDER=fake
# Обязательный отдельный ключ: openssl rand -base64 32
RUNTIME_SECRETS_KEY=
# RUNTIME_WORK_DIR=/var/lib/cellestial/runtime
# RUNTIME_MAX_ACTIVE=3
# RUNTIME_MAX_CONCURRENT_OPS=2

# Dedicated AES-256-GCM key for TOTP secrets: generate with openssl rand -base64 32.
TOTP_ENCRYPTION_KEY=
