# Настройки HTTP сервера
HOST=0.0.0.0
PORT=8080
WRITE_TIMEOUT=15s
READ_TIMEOUT=15s

# Настройки PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secretpassword
POSTGRES_HOST=db
POSTGRES_DB=app_db

# Apidog: нужны только для make generate
APIDOG_TOKEN=
APIDOG_BRANCH_ID=

# Авторизация
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
# true на проде, где есть HTTPS
COOKIE_SECURE=false

# S3: контракт production-конфигурации infra#30.
# Текущий Go API ещё не читает эти параметры; для локального запуска они не нужны.
AWS_REGION=ru-7
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=https://s3.ru-7.storage.selcloud.ru
S3_NOTEBOOKS_BUCKET=
S3_AVATARS_BUCKET=
S3_AVATARS_PUBLIC_URL=https://avatars.cellestial.ru
