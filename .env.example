# Настройки HTTP сервера
HOST=0.0.0.0
PORT=8080
WRITE_TIMEOUT=15s
READ_TIMEOUT=15s

# Настройки PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secretpassword
POSTGRES_HOST=db
POSTGRES_DB=app_db

# Apidog: нужны только для make generate
APIDOG_TOKEN=
APIDOG_BRANCH_ID=

# Авторизация
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
# true на проде, где есть HTTPS
COOKIE_SECURE=false

# S3. Локально SeaweedFS из docker-compose, на проде Selectel
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=devkey
AWS_SECRET_ACCESS_KEY=devsecret
AWS_ENDPOINT_URL_S3=http://s3:8333
S3_NOTEBOOKS_BUCKET=cellestial-notebooks-0

# Origin фронта через запятую. Пусто — CORS выключен: через vite proxy он не нужен, на проде его ставит Caddy
CORS_ALLOWED_ORIGINS=
